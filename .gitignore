# Compiled class file
*.class
*.dex

# Kotlin compiler
.kotlin

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
# but keep the Gradle wrapper jar so ./gradlew works from a fresh clone
!gradle/wrapper/gradle-wrapper.jar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# IDEA/Android Studio project files
*.iml
.idea/
**/.idea/
!.idea/copyright
# Keep the code styles.
!/.idea/codeStyles
!/.idea/codeStyles/Project.xml
!/.idea/codeStyles/codeStyleConfig.xml
!/.idea/detekt.xml

# Gradle cache
.gradle
local.properties

# Android Studio captures folder
captures/

# generated files
bin/
gen/
out/
build/

# track build-logic module
!**/edu/stanford/spezi/build

# built application files
*.apk
*.ap_
*.aab
*.jks

# Other files
.DS_Store

# fastlane
play-store-credentials.json
keystore.jks
app/release/*
app/debug/*
gha-creds-*.json

# services and secrets
modules/account/src/main/res/values/secrets.xml
deployment/secrets/*
!deployment/secrets/README.md
