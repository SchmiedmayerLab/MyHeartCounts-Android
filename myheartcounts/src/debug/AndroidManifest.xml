<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
    Debug-only, so that a build pointed at a local Firebase emulator suite can reach it over plain
    HTTP. The config itself permits only loopback addresses; see network_security_config.xml.
    -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig" />

</manifest>
